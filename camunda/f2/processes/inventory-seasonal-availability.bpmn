    <bpmn:startEvent id="Event_0k7qpmm" name="Order paid - reduce stock">
      <bpmn:documentation>This branch represents how the inventory management process responds to a stock-reduction request following a successful order. It updates stock quantities, checks product availability and sends notifications where necessary. The ordering and payment processes themselves are outside the scope of this model.</bpmn:documentation>
      <bpmn:outgoing>Flow_0urmnr7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0x1jrxl" messageRef="Message_Event_0k7qpmm" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0urmnr7" sourceRef="Event_0k7qpmm" targetRef="Activity_0wf1ny8" />
    <bpmn:serviceTask id="Activity_0wf1ny8" name="Reduce stock by purchased quantity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-reduce-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0urmnr7</bpmn:incoming>
      <bpmn:outgoing>Flow_0j49scp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_03r47f5" name="Stock at zero?" default="Flow_07v7514">
      <bpmn:incoming>Flow_0j49scp</bpmn:incoming>
      <bpmn:outgoing>Flow_09mj54y</bpmn:outgoing>
      <bpmn:outgoing>Flow_07v7514</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0j49scp" sourceRef="Activity_0wf1ny8" targetRef="Gateway_03r47f5" />
    <bpmn:sequenceFlow id="Flow_09mj54y" name="Yes" sourceRef="Gateway_03r47f5" targetRef="Activity_121359a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quantity = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0lj5e6t" name="Within season?" default="Flow_0wm8e9i">
      <bpmn:incoming>Flow_07v7514</bpmn:incoming>
      <bpmn:outgoing>Flow_1fbf6pb</bpmn:outgoing>
      <bpmn:outgoing>Flow_0wm8e9i</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_07v7514" name="No" sourceRef="Gateway_03r47f5" targetRef="Gateway_0lj5e6t" />
    <bpmn:serviceTask id="Activity_121359a" name="Make product unavailable after sale">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-unavailable" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09mj54y</bpmn:incoming>
      <bpmn:outgoing>Flow_01dph98</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1fbf6pb" name="Yes" sourceRef="Gateway_0lj5e6t" targetRef="Activity_02oic3k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=withinSeason</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_02oic3k" name="Keep product available after sale">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-available" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fbf6pb</bpmn:incoming>
      <bpmn:outgoing>Flow_0jil6e4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0wm8e9i" name="No" sourceRef="Gateway_0lj5e6t" targetRef="Activity_0jcnufj" />
    <bpmn:exclusiveGateway id="Gateway_1j4xncw">
      <bpmn:incoming>Flow_0jil6e4</bpmn:incoming>
      <bpmn:incoming>Flow_1u8ux9g</bpmn:incoming>
      <bpmn:incoming>Flow_13l7tno</bpmn:incoming>
      <bpmn:outgoing>Flow_0pqb28a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_01dph98" sourceRef="Activity_121359a" targetRef="Activity_1knv4gv" />
    <bpmn:sequenceFlow id="Flow_0jil6e4" sourceRef="Activity_02oic3k" targetRef="Gateway_1j4xncw" />
    <bpmn:sequenceFlow id="Flow_1u8ux9g" sourceRef="Activity_0jcnufj" targetRef="Gateway_1j4xncw" />
    <bpmn:sequenceFlow id="Flow_0pqb28a" sourceRef="Gateway_1j4xncw" targetRef="Gateway_0k5t49x" />
    <bpmn:exclusiveGateway id="Gateway_0k5t49x" name="Low stock?" default="Flow_1muqdt7">
      <bpmn:incoming>Flow_0pqb28a</bpmn:incoming>
      <bpmn:outgoing>Flow_0fqqhb3</bpmn:outgoing>
      <bpmn:outgoing>Flow_1muqdt7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0fqqhb3" name="Yes" sourceRef="Gateway_0k5t49x" targetRef="Activity_0a0msio">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quantity &gt; 0 and quantity &lt; lowStockThreshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="Activity_0a0msio" name="Send low-stock notification after sale">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-notify-low" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fqqhb3</bpmn:incoming>
      <bpmn:outgoing>Flow_0xhph3q</bpmn:outgoing>
    </bpmn:sendTask>
