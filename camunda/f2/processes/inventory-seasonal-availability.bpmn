    <bpmn:startEvent id="Event_0ii4tpz" name="Season start reached">
      <bpmn:documentation>Triggered when a product reaches its configured seasonal start date. The date is retrieved from the Product Catalogue. Availability is enabled only if the product has stock greater than zero.</bpmn:documentation>
      <bpmn:outgoing>Flow_0ccb63r</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0k570q7">
        <bpmn:timeDate>2026-11-01T00:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_0kucjyc" name="Stock available?" default="Flow_091vx6a">
      <bpmn:incoming>Flow_0qn1zef</bpmn:incoming>
      <bpmn:outgoing>Flow_0ishmbg</bpmn:outgoing>
      <bpmn:outgoing>Flow_091vx6a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1aqxzi0" name="Make product available at season start">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-available" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ishmbg</bpmn:incoming>
      <bpmn:outgoing>Flow_19nxo7i</bpmn:outgoing>
