    <bpmn:sequenceFlow id="Flow_0ishmbg" name="Yes" sourceRef="Gateway_0kucjyc" targetRef="Activity_1aqxzi0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quantity &gt; 0</bpmn:conditionExpression>
