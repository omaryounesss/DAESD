    <bpmn:userTask id="Activity_07qa1zf" name="Review invalid stock update">
      <bpmn:documentation>The Marketplace Administrator reviews stock or seasonal availability updates that have repeatedly failed validation. The administrator decides whether the producer should be allowed another correction attempt or whether the update should be rejected.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f2-inventory-review" bindingType="latest" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ybwghf</bpmn:incoming>
      <bpmn:outgoing>Flow_0utikvr</bpmn:outgoing>
