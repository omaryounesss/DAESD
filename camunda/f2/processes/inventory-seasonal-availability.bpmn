    <bpmn:sequenceFlow id="Flow_1muqdt7" name="No" sourceRef="Gateway_0k5t49x" targetRef="Gateway_1tlh55r" />
    <bpmn:sequenceFlow id="Flow_1gucv37" sourceRef="Gateway_1tlh55r" targetRef="Activity_0kb95hx" />
