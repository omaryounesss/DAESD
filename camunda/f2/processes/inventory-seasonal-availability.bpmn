        <bpmn:targetRef>DataStoreReference_0as5i3t</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_048h4bm" name="Keep product unavailable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-unavailable" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_091vx6a</bpmn:incoming>
      <bpmn:outgoing>Flow_11uqjse</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_18mlopo">
      <bpmn:incoming>Flow_19nxo7i</bpmn:incoming>
      <bpmn:incoming>Flow_11uqjse</bpmn:incoming>
      <bpmn:outgoing>Flow_1vhcup5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0eb6t8d" name="Season-start availability updated">
      <bpmn:incoming>Flow_1vhcup5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_0g3ep4s" name="Season end reached">
      <bpmn:documentation>Triggered when a product reaches its configured seasonal end date. The date is retrieved from the Product Catalogue. The product becomes unavailable regardless of its remaining stock quantity.</bpmn:documentation>
      <bpmn:outgoing>Flow_1klohxp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0m3fr1e">
        <bpmn:timeDate>2027-01-01T00:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_1xtvtom" name="Make product unavailable at season end">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="f2-unavailable" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1klohxp</bpmn:incoming>
      <bpmn:outgoing>Flow_1drh37y</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1kdgntj">
        <bpmn:targetRef>DataStoreReference_0as5i3t</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0s09mrn" name="Season-end availability updated">
      <bpmn:incoming>Flow_1drh37y</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_0u9a3lc" name="Validate stock and season update">
      <bpmn:incoming>Flow_0m6cl3e</bpmn:incoming>
      <bpmn:outgoing>Flow_0rkijvl</bpmn:outgoing>
      <bpmn:startEvent id="Event_044h7gw" name="Start validation">
        <bpmn:outgoing>Flow_04y40rm</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_04y40rm" sourceRef="Event_044h7gw" targetRef="Activity_0hss1ef" />
      <bpmn:serviceTask id="Activity_0hss1ef" name="Validate stock quantity">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="f2-validate-quantity" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_04y40rm</bpmn:incoming>
        <bpmn:outgoing>Flow_1jc9tty</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_1jc9tty" sourceRef="Activity_0hss1ef" targetRef="Activity_0hj1gqm" />
      <bpmn:serviceTask id="Activity_0hj1gqm" name="Validate seasonal availability dates">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="f2-validate-season" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1jc9tty</bpmn:incoming>
        <bpmn:outgoing>Flow_12gab0m</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_1e5no00" name="Validation completed">
        <bpmn:incoming>Flow_12gab0m</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_12gab0m" sourceRef="Activity_0hj1gqm" targetRef="Event_1e5no00" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_187z0zu" sourceRef="Event_0yt42mz" targetRef="Gateway_158vgre" />
