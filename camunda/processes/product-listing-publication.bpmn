<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="e24511c" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_18adoet">
    <bpmn:participant id="Participant_00ej6yr" name="Marketplace" processRef="product-listing-publication"/>
    <bpmn:participant id="Participant_06rxsnm" name="Producer"/>
    <bpmn:participant id="Participant_1smmc2l" name="Organic Certification Service"/>
    <bpmn:messageFlow id="Flow_0ffhbcu" sourceRef="Participant_06rxsnm" targetRef="Task_SubmitDetails"/>
    <bpmn:messageFlow id="Flow_1r13om3" sourceRef="Task_RequestCorrections" targetRef="Participant_06rxsnm"/>
    <bpmn:messageFlow id="Flow_0guozqo" sourceRef="Participant_06rxsnm" targetRef="Task_CorrectDetails"/>
    <bpmn:messageFlow id="Flow_0d3w5qh" name="Certification verification request" sourceRef="Task_RequestCertification" targetRef="Participant_1smmc2l"/>
    <bpmn:messageFlow id="Flow_0pnzg2j" name="Certification verification&#10;result" sourceRef="Participant_1smmc2l" targetRef="Event_CertificationResult"/>
    <bpmn:messageFlow id="Flow_0vuhtwm" sourceRef="Task_NotifyRejected" targetRef="Participant_06rxsnm"/>
    <bpmn:messageFlow id="Flow_0rdx25f" sourceRef="Participant_06rxsnm" targetRef="Task_RejectedDecision"/>
    <bpmn:messageFlow id="Flow_087zyyi" sourceRef="Task_NotifyPublished" targetRef="Participant_06rxsnm"/>
    <bpmn:messageFlow id="Flow_09jc37x" sourceRef="Task_NotifyWithheldRejected" targetRef="Participant_06rxsnm"/>
    <bpmn:messageFlow id="Flow_01577tf" sourceRef="Task_NotifyWithheldManual" targetRef="Participant_06rxsnm"/>
  </bpmn:collaboration>
  <bpmn:process id="product-listing-publication" isExecutable="true" name="Product listing, validation and publication">
    <bpmn:documentation>Executable version of models/operational-bpmn/functionality-1/product-listing.bpmn (Zain-Eldin Sharaf, M3): same diagram, pools, lanes and names, with Camunda implementation added. See docs/camunda-variables.md for each change.</bpmn:documentation><bpmn:laneSet id="LaneSet_0ogm3lm">
      <bpmn:lane id="Lane_059k1rb" name="Marketplace Platform">
        <bpmn:flowNodeRef>Task_CheckOrganicClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrganicClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectedDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RemoveClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemoveClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WithholdRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePublication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveCatalogue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishListing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyWithheldRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_WithheldRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CertificationTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AwaitCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CertificationResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CertificationVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Retries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DetailsValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ValidateDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_ProductListing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_EscalationRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_RecordTraceability</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_SubmitDetails</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_004ilkr" name="Marketplace Administrator">
        <bpmn:flowNodeRef>Gateway_EvidenceVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordManualVerified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyWithheldManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_WithheldManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WithholdManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReviewDeadline</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:scriptTask id="Task_CheckOrganicClaim" name="Check organic claim">
      <bpmn:extensionElements><zeebe:script expression="=organicClaimMade = true" resultVariable="organicClaimMade"/></bpmn:extensionElements><bpmn:incoming>Flow_0twzyaf</bpmn:incoming>
      <bpmn:outgoing>Flow_1pmraj0</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_OrganicClaim" name="Organic claim made?" default="Flow_1g7yrl8">
      <bpmn:incoming>Flow_1pmraj0</bpmn:incoming>
      <bpmn:outgoing>Flow_107jhpn</bpmn:outgoing>
      <bpmn:outgoing>Flow_1g7yrl8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_FlagRejected" name="Flag rejected organic claim">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Organic claim rejected&quot;" resultVariable="organicStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_1vnggnq</bpmn:incoming>
      <bpmn:outgoing>Flow_09kgbee</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyRejected" name="Notify producer of rejected claim">
      <bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;organic-claim-rejected&quot;, listingId: listingId, message: &quot;The organic claim for \&quot;&quot; + productName + &quot;\&quot; could not be verified. Remove the claim or withhold the listing.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications"/></bpmn:extensionElements><bpmn:incoming>Flow_09kgbee</bpmn:incoming>
      <bpmn:outgoing>Flow_01btwdg</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_RejectedDecision" name="Decide on rejected organic claim">
      <bpmn:extensionElements><zeebe:userTask/><zeebe:formDefinition formId="rejected-organic-claim-form"/><zeebe:ioMapping><zeebe:output source="=rejectedClaimDecision" target="rejectedClaimDecision"/><zeebe:output source="=rejectedClaimDecision = &quot;remove-claim&quot;" target="removeOrganicClaim"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_01btwdg</bpmn:incoming>
      <bpmn:outgoing>Flow_0xdao2o</bpmn:outgoing>
      </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RemoveClaim" name="Remove organic claim?" default="Flow_0nwg6d4">
      <bpmn:incoming>Flow_0xdao2o</bpmn:incoming>
      <bpmn:outgoing>Flow_1mrstv3</bpmn:outgoing>
      <bpmn:outgoing>Flow_0nwg6d4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RemoveClaim" name="Remove organic claim from listing">
      <bpmn:extensionElements><zeebe:script expression="=false" resultVariable="organicClaimMade"/></bpmn:extensionElements><bpmn:incoming>Flow_1mrstv3</bpmn:incoming>
      <bpmn:outgoing>Flow_0anpm3y</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_WithholdRejected" name="Withhold listing">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Withheld&quot;" resultVariable="listingStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_0nwg6d4</bpmn:incoming>
      <bpmn:outgoing>Flow_0ncnkgg</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Listing approved for publication">
      <bpmn:incoming>Flow_0uq1lto</bpmn:incoming>
      <bpmn:incoming>Flow_139vq1g</bpmn:incoming>
      <bpmn:incoming>Flow_0anpm3y</bpmn:incoming>
      <bpmn:incoming>Flow_1g7yrl8</bpmn:incoming>
      <bpmn:outgoing>Flow_06fgizu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_PreparePublication" name="Prepare validated product for publication">
      <bpmn:extensionElements><zeebe:script expression="={listingId: listingId, producerName: producerName, name: productName, description: productDescription, category: category, price: price, quantity: quantity, availableFrom: availableFrom, availableUntil: availableUntil, organic: organicClaimMade, organicStatus: if organicClaimMade then organicStatus else &quot;Not organic&quot;}" resultVariable="product"/></bpmn:extensionElements><bpmn:incoming>Flow_06fgizu</bpmn:incoming>
      <bpmn:outgoing>Flow_1rrza17</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_SaveCatalogue" name="Save product to catalogue">
      <bpmn:extensionElements><zeebe:script expression="={product: product, savedAt: string(now())}" resultVariable="catalogueEntry"/></bpmn:extensionElements><bpmn:incoming>Flow_1rrza17</bpmn:incoming>
      <bpmn:outgoing>Flow_1m1aceo</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_07l2zea">
        <bpmn:targetRef>DataStoreReference_16jue4g</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_PublishListing" name="Publish product listing">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Published&quot;" resultVariable="listingStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_0vhia0y</bpmn:incoming>
      <bpmn:outgoing>Flow_0impmxw</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyPublished" name="Notify producer of successful publication">
      <bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;listing-published&quot;, listingId: listingId, message: &quot;Your listing \&quot;&quot; + productName + &quot;\&quot; is now published in the catalogue.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications"/></bpmn:extensionElements><bpmn:incoming>Flow_0impmxw</bpmn:incoming>
      <bpmn:outgoing>Flow_1obx9km</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Published" name="Product listing published successfully">
      <bpmn:incoming>Flow_1obx9km</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_NotifyWithheldRejected" name="Notify producer that listing was withheld">
      <bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;listing-withheld&quot;, listingId: listingId, message: &quot;Your listing \&quot;&quot; + productName + &quot;\&quot; has been withheld because its organic claim was rejected.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications"/></bpmn:extensionElements><bpmn:incoming>Flow_0ncnkgg</bpmn:incoming>
      <bpmn:outgoing>Flow_1urluq5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_WithheldRejected" name="Listing withheld">
      <bpmn:incoming>Flow_1urluq5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_RecordTimeout" name="Record certification timeout">
      <bpmn:documentation>When certification verification times out, the process checks whether another attempt is permitted. The variable certificationAttempts counts requests sent, including the initial request. It is initialised to zero before the first request and incremented once each time a certification request is sent. A maximum of three requests is permitted. After the third timeout, the listing is escalated for manual review.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:script expression="=if certificationAttempts = null then 1 else certificationAttempts + 1" resultVariable="certificationAttempts"/></bpmn:extensionElements><bpmn:incoming>Flow_0hezqyk</bpmn:incoming>
      <bpmn:outgoing>Flow_1h6asef</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Event_CertificationTimeout" name="Certification response timeout">
      <bpmn:incoming>Flow_13fop81</bpmn:incoming>
      <bpmn:outgoing>Flow_0hezqyk</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1oeh2ig">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gateway_AwaitCertification">
      <bpmn:incoming>Flow_1hvuehq</bpmn:incoming>
      <bpmn:outgoing>Flow_1ix5au9</bpmn:outgoing>
      <bpmn:outgoing>Flow_13fop81</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:scriptTask id="Task_RecordVerified" name="Record verified organic status">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Verified organic&quot;" resultVariable="organicStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_0s38su7</bpmn:incoming>
      <bpmn:outgoing>Flow_139vq1g</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0t68osh">
        <bpmn:targetRef>DataStoreReference_1jwjp5e</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Event_CertificationResult" name="Certification result received">
      <bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=certificationStatus" target="certificationStatus"/><zeebe:output source="=certificationStatus = &quot;verified&quot;" target="certificationVerified"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_1ix5au9</bpmn:incoming>
      <bpmn:outgoing>Flow_05xw9y5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0nj7fiv">
        <bpmn:targetRef>DataObjectReference_16zde7k</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0xi99vj" messageRef="Message_CertificationResult"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_CertificationVerified" name="Certification verified?" default="Flow_1vnggnq">
      <bpmn:incoming>Flow_05xw9y5</bpmn:incoming>
      <bpmn:outgoing>Flow_0s38su7</bpmn:outgoing>
      <bpmn:outgoing>Flow_1vnggnq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestCertification" name="Request certification verification">
      <bpmn:documentation>Each time this task sends a certification verification request, certificationAttempts is incremented by one. The counter is initialised to zero before the first request. The task sends the request to the Organic Certification Service.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="request-certification-verification" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_09p344c</bpmn:incoming>
      <bpmn:outgoing>Flow_1hvuehq</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_MergeRequest">
      <bpmn:incoming>Flow_107jhpn</bpmn:incoming>
      <bpmn:incoming>Flow_13tjh83</bpmn:incoming>
      <bpmn:outgoing>Flow_09p344c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_FlagManualReview" name="Flag listing for manual review">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Pending manual review&quot;" resultVariable="listingStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_00abel7</bpmn:incoming>
      <bpmn:outgoing>Flow_1f3fp0q</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Retries" name="Retry attempts remaining?" default="Flow_00abel7">
      <bpmn:documentation>The process permits a maximum of three certification verification requests, including the initial request and two retries. If fewer than three requests have been made, the process retries verification. Otherwise, the listing is escalated for manual review.</bpmn:documentation>
      <bpmn:incoming>Flow_1h6asef</bpmn:incoming>
      <bpmn:outgoing>Flow_00abel7</bpmn:outgoing>
      <bpmn:outgoing>Flow_13tjh83</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_EvidenceVerified" name="Organic evidence verified?" default="Flow_1m3z35p">
      <bpmn:incoming>Flow_0jq0h51</bpmn:incoming>
      <bpmn:outgoing>Flow_00yr1nm</bpmn:outgoing>
      <bpmn:outgoing>Flow_1m3z35p</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RecordManualVerified" name="Record manually verified certification">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Verified organic (manual review)&quot;" resultVariable="organicStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_00yr1nm</bpmn:incoming>
      <bpmn:outgoing>Flow_0uq1lto</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1kpp3aw">
        <bpmn:targetRef>DataStoreReference_1jwjp5e</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyWithheldManual" name="Notify producer that listing was withheld">
      <bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;listing-withheld&quot;, listingId: listingId, message: &quot;Your listing \&quot;&quot; + productName + &quot;\&quot; has been withheld: the organic evidence could not be verified by manual review.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications"/></bpmn:extensionElements><bpmn:incoming>Flow_141v5ka</bpmn:incoming>
      <bpmn:outgoing>Flow_1621ecu</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_WithheldManual" name="Listing withheld">
      <bpmn:incoming>Flow_1621ecu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_ManualReview" name="Manually review certification">
      <bpmn:documentation>The Marketplace Administrator reviews submitted certification evidence, checks producer and certification details, and records a justified approval or rejection decision. The review produces the Boolean variable manualCertificationVerified, which determines whether the listing may proceed with its organic claim or must be withheld.</bpmn:documentation>
      <bpmn:incoming>Flow_1f3fp0q</bpmn:incoming>
      <bpmn:outgoing>Flow_0jq0h51</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0p9abmx">
        <bpmn:targetRef>DataObjectReference_0h7zqgw</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Start_ManualReview" name="Manual review initiated">
        <bpmn:outgoing>Flow_1cx4l11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1cx4l11" sourceRef="Start_ManualReview" targetRef="Task_ReviewEvidence"/>
      <bpmn:sequenceFlow id="Flow_0iwpp9a" sourceRef="Task_ReviewEvidence" targetRef="Task_CheckProducerDetails"/>
      <bpmn:userTask id="Task_ReviewEvidence" name="Review submitted certification evidence">
        <bpmn:extensionElements><zeebe:userTask/><zeebe:formDefinition formId="certification-evidence-review-form"/></bpmn:extensionElements><bpmn:incoming>Flow_1cx4l11</bpmn:incoming>
        <bpmn:outgoing>Flow_0iwpp9a</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_CheckProducerDetails" name="Check producer and certification details">
        <bpmn:extensionElements><zeebe:userTask/><zeebe:formDefinition formId="producer-certification-check-form"/></bpmn:extensionElements><bpmn:incoming>Flow_0iwpp9a</bpmn:incoming>
        <bpmn:outgoing>Flow_0bawn2x</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_0bawn2x" sourceRef="Task_CheckProducerDetails" targetRef="Task_RecordReviewDecision"/>
      <bpmn:endEvent id="End_ManualReview" name="Manual review completed">
        <bpmn:incoming>Flow_0ka957w</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0ka957w" sourceRef="Task_RecordReviewDecision" targetRef="End_ManualReview"/>
      <bpmn:userTask id="Task_RecordReviewDecision" name="Record manual review decision">
        <bpmn:extensionElements><zeebe:userTask/><zeebe:formDefinition formId="manual-certification-review-form"/><zeebe:ioMapping><zeebe:output source="=manualReviewDecision" target="manualReviewDecision"/><zeebe:output source="=manualReviewNotes" target="manualReviewNotes"/><zeebe:output source="=manualReviewDecision = &quot;approve&quot;" target="manualCertificationVerified"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_0bawn2x</bpmn:incoming>
        <bpmn:outgoing>Flow_0ka957w</bpmn:outgoing>
      </bpmn:userTask>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_13wctob" sourceRef="SubProcess_ValidateDetails" targetRef="Gateway_DetailsValid"/>
    <bpmn:sequenceFlow id="Flow_0twzyaf" name="Yes" sourceRef="Gateway_DetailsValid" targetRef="Task_CheckOrganicClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=productDetailsValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_126p4gw" name="No" sourceRef="Gateway_DetailsValid" targetRef="Task_RequestCorrections">
      </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0lharp7" sourceRef="Task_RequestCorrections" targetRef="Task_CorrectDetails"/>
    <bpmn:sequenceFlow id="Flow_01yinuu" sourceRef="Task_CorrectDetails" targetRef="Gateway_MergeValidation"/>
    <bpmn:sequenceFlow id="Flow_1pmraj0" sourceRef="Task_CheckOrganicClaim" targetRef="Gateway_OrganicClaim"/>
    <bpmn:sequenceFlow id="Flow_107jhpn" name="Yes" sourceRef="Gateway_OrganicClaim" targetRef="Gateway_MergeRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=organicClaimMade = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1g7yrl8" name="No" sourceRef="Gateway_OrganicClaim" targetRef="Gateway_Approved">
      </bpmn:sequenceFlow>
