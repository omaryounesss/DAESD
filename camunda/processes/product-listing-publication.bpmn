<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProductListing" targetNamespace="https://daesd.uwe.ac.uk/camunda" exporter="Camunda Modeler" exporterVersion="5.30.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="product-listing-publication" name="Product listing, validation and publication" isExecutable="true">
    <bpmn:documentation>Executable Camunda 8 implementation of Functionality 1. Source model: models/operational-bpmn/functionality-1/product-listing.bpmn (Zain-Eldin Sharaf, M3). Element names match the operational model; see docs/camunda-variables.md for the mapping.</bpmn:documentation>
    <bpmn:startEvent id="Start_ProductListing" name="Producer starts listing"><bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitDetails" name="Submit product details"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="product-listing-form" /></bpmn:extensionElements><bpmn:incoming>Flow_Start_Submit</bpmn:incoming><bpmn:outgoing>Flow_Submit_Merge</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeValidation"><bpmn:incoming>Flow_Submit_Merge</bpmn:incoming><bpmn:incoming>Flow_Correct_Merge</bpmn:incoming><bpmn:outgoing>Flow_Merge_Validate</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_ValidateDetails" name="Validate product details"><bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=[]" target="validationErrors" /><zeebe:output source="=validationErrors" target="validationErrors" /><zeebe:output source="=count(validationErrors) = 0" target="productDetailsValid" /><zeebe:output source="=if listingId = null then &quot;LST-&quot; + substring(replace(string(now()), &quot;[^0-9]&quot;, &quot;&quot;), 1, 17) else listingId" target="listingId" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Merge_Validate</bpmn:incoming><bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
      <bpmn:startEvent id="Start_Validation" name="Start validation"><bpmn:outgoing>Flow_V1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:scriptTask id="Task_ValidateMandatory" name="Validate mandatory product fields"><bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if producerName = null or producerName = &quot;&quot; then [&quot;Producer name is required.&quot;] else [], if productName = null or productName = &quot;&quot; then [&quot;Product name is required.&quot;] else [], if productDescription = null or productDescription = &quot;&quot; then [&quot;Description is required.&quot;] else [], if category = null or category = &quot;&quot; then [&quot;Category is required.&quot;] else [], if origin = null or origin = &quot;&quot; then [&quot;Farm origin is required.&quot;] else [], if allergens = null or allergens = &quot;&quot; then [&quot;Allergen information is required.&quot;] else [], if harvestDate = null or harvestDate = &quot;&quot; then [&quot;Harvest date is required.&quot;] else [], if bestBeforeDate = null or bestBeforeDate = &quot;&quot; then [&quot;Best-before date is required.&quot;] else [], if availableFrom = null or availableFrom = &quot;&quot; then [&quot;Availability start date is required.&quot;] else [], if availableUntil = null or availableUntil = &quot;&quot; then [&quot;Availability end date is required.&quot;] else [], if price = null then [&quot;Price is required.&quot;] else [], if quantity = null then [&quot;Quantity is required.&quot;] else [])" resultVariable="validationErrors" /></bpmn:extensionElements><bpmn:incoming>Flow_V1</bpmn:incoming><bpmn:outgoing>Flow_V2</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidatePriceStock" name="Validate price and stock quantity"><bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if price != null and price &lt;= 0 then [&quot;Price must be greater than zero.&quot;] else [], if quantity != null and quantity &lt; 0 then [&quot;Quantity cannot be negative.&quot;] else [], if quantity != null and floor(quantity) != quantity then [&quot;Quantity must be a whole number.&quot;] else [])" resultVariable="validationErrors" /></bpmn:extensionElements><bpmn:incoming>Flow_V2</bpmn:incoming><bpmn:outgoing>Flow_V3</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidateSeason" name="Validate seasonal availability dates"><bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if availableFrom != null and availableFrom != &quot;&quot; and availableUntil != null and availableUntil != &quot;&quot; and date(availableUntil) &lt; date(availableFrom) then [&quot;Availability end date must be on or after the start date.&quot;] else [])" resultVariable="validationErrors" /></bpmn:extensionElements><bpmn:incoming>Flow_V3</bpmn:incoming><bpmn:outgoing>Flow_V4</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidateOrigin" name="Validate origin and harvest information"><bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if harvestDate != null and harvestDate != &quot;&quot; and date(harvestDate) &gt; today() then [&quot;Harvest date cannot be in the future.&quot;] else [])" resultVariable="validationErrors" /></bpmn:extensionElements><bpmn:incoming>Flow_V4</bpmn:incoming><bpmn:outgoing>Flow_V5</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidateAllergenDates" name="Validate allergen and date information"><bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if bestBeforeDate != null and bestBeforeDate != &quot;&quot; and harvestDate != null and harvestDate != &quot;&quot; and date(bestBeforeDate) &lt;= date(harvestDate) then [&quot;Best-before date must be after the harvest date.&quot;] else [], if bestBeforeDate != null and bestBeforeDate != &quot;&quot; and date(bestBeforeDate) &lt; today() then [&quot;Best-before date has already passed.&quot;] else [])" resultVariable="validationErrors" /></bpmn:extensionElements><bpmn:incoming>Flow_V5</bpmn:incoming><bpmn:outgoing>Flow_V6</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:scriptTask id="Task_CheckCertificationDetails" name="Check organic certification details"><bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if organicClaimMade = true and (certificationReference = null or certificationReference = &quot;&quot;) then [&quot;A certification reference is required for an organic claim.&quot;] else if organicClaimMade = true and not(matches(certificationReference, &quot;^GB-ORG-[0-9]{2}$&quot;)) then [&quot;Certification reference must be a UK organic control body code, e.g. GB-ORG-05.&quot;] else [])" resultVariable="validationErrors" /></bpmn:extensionElements><bpmn:incoming>Flow_V6</bpmn:incoming><bpmn:outgoing>Flow_V7</bpmn:outgoing></bpmn:scriptTask>
      <bpmn:endEvent id="End_Validation" name="Validation completed"><bpmn:incoming>Flow_V7</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_V1" sourceRef="Start_Validation" targetRef="Task_ValidateMandatory" />
      <bpmn:sequenceFlow id="Flow_V2" sourceRef="Task_ValidateMandatory" targetRef="Task_ValidatePriceStock" />
      <bpmn:sequenceFlow id="Flow_V3" sourceRef="Task_ValidatePriceStock" targetRef="Task_ValidateSeason" />
      <bpmn:sequenceFlow id="Flow_V4" sourceRef="Task_ValidateSeason" targetRef="Task_ValidateOrigin" />
      <bpmn:sequenceFlow id="Flow_V5" sourceRef="Task_ValidateOrigin" targetRef="Task_ValidateAllergenDates" />
      <bpmn:sequenceFlow id="Flow_V6" sourceRef="Task_ValidateAllergenDates" targetRef="Task_CheckCertificationDetails" />
      <bpmn:sequenceFlow id="Flow_V7" sourceRef="Task_CheckCertificationDetails" targetRef="End_Validation" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_DetailsValid" name="Product details valid?" default="Flow_DetailsInvalid"><bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming><bpmn:outgoing>Flow_DetailsValid</bpmn:outgoing><bpmn:outgoing>Flow_DetailsInvalid</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RequestCorrections" name="Request product corrections"><bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;correction-requested&quot;, listingId: listingId, message: &quot;Your listing needs correction: &quot; + string join(validationErrors, &quot; &quot;), sentAt: string(now())}])" resultVariable="producerNotifications" /></bpmn:extensionElements><bpmn:incoming>Flow_DetailsInvalid</bpmn:incoming><bpmn:outgoing>Flow_Request_Correct</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="Task_CorrectDetails" name="Submit corrected product details"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="product-correction-form" /></bpmn:extensionElements><bpmn:incoming>Flow_Request_Correct</bpmn:incoming><bpmn:outgoing>Flow_Correct_Merge</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="Task_CheckOrganicClaim" name="Check organic claim"><bpmn:extensionElements><zeebe:script expression="=organicClaimMade = true" resultVariable="organicClaimMade" /></bpmn:extensionElements><bpmn:incoming>Flow_DetailsValid</bpmn:incoming><bpmn:outgoing>Flow_Check_Gateway</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_OrganicClaim" name="Organic claim made?" default="Flow_OrganicNo"><bpmn:incoming>Flow_Check_Gateway</bpmn:incoming><bpmn:outgoing>Flow_OrganicYes</bpmn:outgoing><bpmn:outgoing>Flow_OrganicNo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeRequest"><bpmn:incoming>Flow_OrganicYes</bpmn:incoming><bpmn:incoming>Flow_RetryYes</bpmn:incoming><bpmn:outgoing>Flow_Merge_Request</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestCertification" name="Request certification verification"><bpmn:extensionElements><zeebe:taskDefinition type="request-certification-verification" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Merge_Request</bpmn:incoming><bpmn:outgoing>Flow_Request_Await</bpmn:outgoing></bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_AwaitCertification"><bpmn:incoming>Flow_Request_Await</bpmn:incoming><bpmn:outgoing>Flow_Await_Result</bpmn:outgoing><bpmn:outgoing>Flow_Await_Timeout</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_CertificationResult" name="Certification result received"><bpmn:incoming>Flow_Await_Result</bpmn:incoming><bpmn:outgoing>Flow_Result_Verified</bpmn:outgoing><bpmn:messageEventDefinition id="MessageEventDefinition_CertificationResult" messageRef="Message_CertificationResult" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_CertificationVerified" name="Certification verified?" default="Flow_CertificationRejected"><bpmn:incoming>Flow_Result_Verified</bpmn:incoming><bpmn:outgoing>Flow_CertificationVerified</bpmn:outgoing><bpmn:outgoing>Flow_CertificationRejected</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RecordVerified" name="Record verified organic status"><bpmn:extensionElements><zeebe:script expression="=&quot;Verified organic&quot;" resultVariable="organicStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_CertificationVerified</bpmn:incoming><bpmn:outgoing>Flow_RecordVerified_Approved</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_FlagRejected" name="Flag rejected organic claim"><bpmn:extensionElements><zeebe:script expression="=&quot;Organic claim rejected&quot;" resultVariable="organicStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_CertificationRejected</bpmn:incoming><bpmn:outgoing>Flow_Flag_NotifyRejected</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyRejected" name="Notify producer of rejected claim"><bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;organic-claim-rejected&quot;, listingId: listingId, message: &quot;The organic claim for \&quot;&quot; + productName + &quot;\&quot; could not be verified. Remove the claim or withhold the listing.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications" /></bpmn:extensionElements><bpmn:incoming>Flow_Flag_NotifyRejected</bpmn:incoming><bpmn:outgoing>Flow_NotifyRejected_Decision</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="Task_RejectedDecision" name="Decide on rejected organic claim"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="rejected-organic-claim-form" /></bpmn:extensionElements><bpmn:incoming>Flow_NotifyRejected_Decision</bpmn:incoming><bpmn:outgoing>Flow_Decision_Gateway</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RemoveClaim" name="Remove organic claim?" default="Flow_RemoveClaimNo"><bpmn:incoming>Flow_Decision_Gateway</bpmn:incoming><bpmn:outgoing>Flow_RemoveClaimYes</bpmn:outgoing><bpmn:outgoing>Flow_RemoveClaimNo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RemoveClaim" name="Remove organic claim from listing"><bpmn:extensionElements><zeebe:script expression="=false" resultVariable="organicClaimMade" /></bpmn:extensionElements><bpmn:incoming>Flow_RemoveClaimYes</bpmn:incoming><bpmn:outgoing>Flow_Remove_Approved</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_WithholdRejected" name="Withhold listing"><bpmn:extensionElements><zeebe:script expression="=&quot;Withheld&quot;" resultVariable="listingStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_RemoveClaimNo</bpmn:incoming><bpmn:outgoing>Flow_WithholdRejected_Notify</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyWithheldRejected" name="Notify producer that listing was withheld"><bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;listing-withheld&quot;, listingId: listingId, message: &quot;Your listing \&quot;&quot; + productName + &quot;\&quot; has been withheld because its organic claim was rejected.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications" /></bpmn:extensionElements><bpmn:incoming>Flow_WithholdRejected_Notify</bpmn:incoming><bpmn:outgoing>Flow_NotifyWithheldRejected_End</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="End_WithheldRejected" name="Listing withheld"><bpmn:incoming>Flow_NotifyWithheldRejected_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_CertificationTimeout" name="Certification response timeout"><bpmn:incoming>Flow_Await_Timeout</bpmn:incoming><bpmn:outgoing>Flow_Timeout_Record</bpmn:outgoing><bpmn:timerEventDefinition id="TimerEventDefinition_CertificationTimeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_RecordTimeout" name="Record certification timeout"><bpmn:extensionElements><zeebe:script expression="=if certificationAttempts = null then 1 else certificationAttempts + 1" resultVariable="certificationAttempts" /></bpmn:extensionElements><bpmn:incoming>Flow_Timeout_Record</bpmn:incoming><bpmn:outgoing>Flow_Record_Retries</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Retries" name="Retry attempts remaining?" default="Flow_RetryNo"><bpmn:incoming>Flow_Record_Retries</bpmn:incoming><bpmn:outgoing>Flow_RetryYes</bpmn:outgoing><bpmn:outgoing>Flow_RetryNo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_FlagManualReview" name="Flag listing for manual review"><bpmn:extensionElements><zeebe:script expression="=&quot;Pending manual review&quot;" resultVariable="listingStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_RetryNo</bpmn:incoming><bpmn:outgoing>Flow_Flag_ManualReview</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:subProcess id="SubProcess_ManualReview" name="Manually review certification"><bpmn:incoming>Flow_Flag_ManualReview</bpmn:incoming><bpmn:outgoing>Flow_Manual_Gateway</bpmn:outgoing>
      <bpmn:startEvent id="Start_ManualReview" name="Manual review initiated"><bpmn:outgoing>Flow_M1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="Task_ReviewEvidence" name="Review submitted certification evidence"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="certification-evidence-review-form" /></bpmn:extensionElements><bpmn:incoming>Flow_M1</bpmn:incoming><bpmn:outgoing>Flow_M2</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="Task_CheckProducerDetails" name="Check producer and certification details"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="producer-certification-check-form" /></bpmn:extensionElements><bpmn:incoming>Flow_M2</bpmn:incoming><bpmn:outgoing>Flow_M3</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="Task_RecordReviewDecision" name="Record manual review decision"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-certification-review-form" /></bpmn:extensionElements><bpmn:incoming>Flow_M3</bpmn:incoming><bpmn:outgoing>Flow_M4</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="End_ManualReview" name="Manual review completed"><bpmn:incoming>Flow_M4</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_M1" sourceRef="Start_ManualReview" targetRef="Task_ReviewEvidence" />
      <bpmn:sequenceFlow id="Flow_M2" sourceRef="Task_ReviewEvidence" targetRef="Task_CheckProducerDetails" />
      <bpmn:sequenceFlow id="Flow_M3" sourceRef="Task_CheckProducerDetails" targetRef="Task_RecordReviewDecision" />
      <bpmn:sequenceFlow id="Flow_M4" sourceRef="Task_RecordReviewDecision" targetRef="End_ManualReview" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_ReviewDeadline" name="Manual review deadline exceeded" cancelActivity="false" attachedToRef="SubProcess_ManualReview"><bpmn:outgoing>Flow_Deadline_Overdue</bpmn:outgoing><bpmn:timerEventDefinition id="TimerEventDefinition_ReviewDeadline"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_FlagOverdue" name="Flag manual review as overdue"><bpmn:extensionElements><zeebe:script expression="=true" resultVariable="manualReviewOverdue" /></bpmn:extensionElements><bpmn:incoming>Flow_Deadline_Overdue</bpmn:incoming><bpmn:outgoing>Flow_Overdue_End</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="End_EscalationRecorded" name="Escalation recorded"><bpmn:incoming>Flow_Overdue_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_EvidenceVerified" name="Organic evidence verified?" default="Flow_EvidenceNo"><bpmn:incoming>Flow_Manual_Gateway</bpmn:incoming><bpmn:outgoing>Flow_EvidenceYes</bpmn:outgoing><bpmn:outgoing>Flow_EvidenceNo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RecordManualVerified" name="Record manually verified certification"><bpmn:extensionElements><zeebe:script expression="=&quot;Verified organic (manual review)&quot;" resultVariable="organicStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_EvidenceYes</bpmn:incoming><bpmn:outgoing>Flow_ManualVerified_Approved</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_WithholdManual" name="Withhold listing"><bpmn:extensionElements><zeebe:script expression="=&quot;Withheld&quot;" resultVariable="listingStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_EvidenceNo</bpmn:incoming><bpmn:outgoing>Flow_WithholdManual_Notify</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyWithheldManual" name="Notify producer that listing was withheld"><bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;listing-withheld&quot;, listingId: listingId, message: &quot;Your listing \&quot;&quot; + productName + &quot;\&quot; has been withheld: the organic evidence could not be verified by manual review.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications" /></bpmn:extensionElements><bpmn:incoming>Flow_WithholdManual_Notify</bpmn:incoming><bpmn:outgoing>Flow_NotifyWithheldManual_End</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="End_WithheldManual" name="Listing withheld"><bpmn:incoming>Flow_NotifyWithheldManual_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Listing approved for publication"><bpmn:incoming>Flow_OrganicNo</bpmn:incoming><bpmn:incoming>Flow_RecordVerified_Approved</bpmn:incoming><bpmn:incoming>Flow_Remove_Approved</bpmn:incoming><bpmn:incoming>Flow_ManualVerified_Approved</bpmn:incoming><bpmn:outgoing>Flow_Approved_Prepare</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_PreparePublication" name="Prepare validated product for publication"><bpmn:extensionElements><zeebe:script expression="={listingId: listingId, producerName: producerName, name: productName, description: productDescription, category: category, price: price, quantity: quantity, availableFrom: availableFrom, availableUntil: availableUntil, organic: organicClaimMade, organicStatus: if organicClaimMade then organicStatus else &quot;Not organic&quot;}" resultVariable="product" /></bpmn:extensionElements><bpmn:incoming>Flow_Approved_Prepare</bpmn:incoming><bpmn:outgoing>Flow_Prepare_Save</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_SaveCatalogue" name="Save product to catalogue"><bpmn:extensionElements><zeebe:script expression="={product: product, savedAt: string(now())}" resultVariable="catalogueEntry" /></bpmn:extensionElements><bpmn:incoming>Flow_Prepare_Save</bpmn:incoming><bpmn:outgoing>Flow_Save_Trace</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:callActivity id="Call_RecordTraceability" name="Record product traceability"><bpmn:extensionElements><zeebe:calledElement processId="record-product-traceability" propagateAllChildVariables="true" /></bpmn:extensionElements><bpmn:incoming>Flow_Save_Trace</bpmn:incoming><bpmn:outgoing>Flow_Trace_Publish</bpmn:outgoing></bpmn:callActivity>
    <bpmn:scriptTask id="Task_PublishListing" name="Publish product listing"><bpmn:extensionElements><zeebe:script expression="=&quot;Published&quot;" resultVariable="listingStatus" /></bpmn:extensionElements><bpmn:incoming>Flow_Trace_Publish</bpmn:incoming><bpmn:outgoing>Flow_Publish_Notify</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifyPublished" name="Notify producer of successful publication"><bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;listing-published&quot;, listingId: listingId, message: &quot;Your listing \&quot;&quot; + productName + &quot;\&quot; is now published in the catalogue.&quot;, sentAt: string(now())}])" resultVariable="producerNotifications" /></bpmn:extensionElements><bpmn:incoming>Flow_Publish_Notify</bpmn:incoming><bpmn:outgoing>Flow_Notify_End</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="End_Published" name="Product listing published successfully"><bpmn:incoming>Flow_Notify_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start_ProductListing" targetRef="Task_SubmitDetails" />
    <bpmn:sequenceFlow id="Flow_Submit_Merge" sourceRef="Task_SubmitDetails" targetRef="Gateway_MergeValidation" />
    <bpmn:sequenceFlow id="Flow_Merge_Validate" sourceRef="Gateway_MergeValidation" targetRef="SubProcess_ValidateDetails" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="SubProcess_ValidateDetails" targetRef="Gateway_DetailsValid" />
    <bpmn:sequenceFlow id="Flow_DetailsValid" name="Yes" sourceRef="Gateway_DetailsValid" targetRef="Task_CheckOrganicClaim"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=productDetailsValid = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DetailsInvalid" name="No" sourceRef="Gateway_DetailsValid" targetRef="Task_RequestCorrections" />
    <bpmn:sequenceFlow id="Flow_Request_Correct" sourceRef="Task_RequestCorrections" targetRef="Task_CorrectDetails" />
    <bpmn:sequenceFlow id="Flow_Correct_Merge" sourceRef="Task_CorrectDetails" targetRef="Gateway_MergeValidation" />
    <bpmn:sequenceFlow id="Flow_Check_Gateway" sourceRef="Task_CheckOrganicClaim" targetRef="Gateway_OrganicClaim" />
