      <bpmn:outgoing>Flow_1ymm35w</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="Call_RecordTraceability" name="Record product traceability">
      <bpmn:extensionElements><zeebe:calledElement processId="record_product_traceability" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:output source="=traceabilityRecord" target="traceabilityRecord"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_1m1aceo</bpmn:incoming>
      <bpmn:outgoing>Flow_0vhia0y</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_000iyl9">
        <bpmn:targetRef>DataStoreReference_11m9c73</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>
  </bpmn:process>
