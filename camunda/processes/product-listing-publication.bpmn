    <bpmn:userTask id="Task_SubmitDetails" name="Submit product details"><bpmn:extensionElements><zeebe:userTask/><zeebe:formDefinition formId="product-listing-form"/></bpmn:extensionElements><bpmn:incoming>Flow_Start_Submit</bpmn:incoming><bpmn:outgoing>Flow_16p8ggf</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="Boundary_ReviewDeadline" name="Manual review deadline exceeded" cancelActivity="false" attachedToRef="SubProcess_ManualReview">
      <bpmn:outgoing>Flow_0j3gpes</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_048oi87">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
