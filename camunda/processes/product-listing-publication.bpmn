    <bpmn:userTask id="Task_CorrectDetails" name="Submit corrected product details">
      <bpmn:extensionElements><zeebe:userTask/><zeebe:formDefinition formId="product-correction-form"/></bpmn:extensionElements><bpmn:incoming>Flow_0lharp7</bpmn:incoming>
      <bpmn:outgoing>Flow_01yinuu</bpmn:outgoing>
      </bpmn:userTask>
    <bpmn:scriptTask id="Task_RequestCorrections" name="Request product corrections">
      <bpmn:extensionElements><zeebe:script expression="=concatenate(if producerNotifications = null then [] else producerNotifications, [{type: &quot;correction-requested&quot;, listingId: listingId, message: &quot;Your listing needs correction: &quot; + string join(validationErrors, &quot; &quot;), sentAt: string(now())}])" resultVariable="producerNotifications"/></bpmn:extensionElements><bpmn:incoming>Flow_126p4gw</bpmn:incoming>
      <bpmn:outgoing>Flow_0lharp7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_DetailsValid" name="Product details valid?" default="Flow_126p4gw">
      <bpmn:incoming>Flow_13wctob</bpmn:incoming>
      <bpmn:outgoing>Flow_0twzyaf</bpmn:outgoing>
      <bpmn:outgoing>Flow_126p4gw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_ValidateDetails" name="Validate product details">
      <bpmn:documentation>Validates mandatory product fields, price and quantity, seasonal availability dates, origin and harvest information, allergen and date information, and organic certification details. Each validation task contributes to the overall result. The subprocess must produce the Boolean variable productDetailsValid, which is true only when all required checks pass. Otherwise, it is false and the producer must correct the submitted details.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=[]" target="validationErrors"/><zeebe:output source="=validationErrors" target="validationErrors"/><zeebe:output source="=count(validationErrors) = 0" target="productDetailsValid"/><zeebe:output source="=if listingId = null then &quot;LST-&quot; + substring(replace(string(now()), &quot;[^0-9]&quot;, &quot;&quot;), 1, 17) else listingId" target="listingId"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_0xusgzj</bpmn:incoming>
      <bpmn:outgoing>Flow_13wctob</bpmn:outgoing>
      <bpmn:property id="Property_1d98evi" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_1j0hx31">
        <bpmn:sourceRef>DataObjectReference_1aptw5a</bpmn:sourceRef>
        <bpmn:targetRef>Property_1d98evi</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:startEvent id="Start_Validation" name="Start validation">
        <bpmn:outgoing>Flow_1ng29mg</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1ng29mg" sourceRef="Start_Validation" targetRef="Task_ValidateMandatory"/>
      <bpmn:scriptTask id="Task_ValidateMandatory" name="Validate mandatory product fields">
        <bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if producerName = null or producerName = &quot;&quot; then [&quot;Producer name is required.&quot;] else [], if productName = null or productName = &quot;&quot; then [&quot;Product name is required.&quot;] else [], if productDescription = null or productDescription = &quot;&quot; then [&quot;Description is required.&quot;] else [], if category = null or category = &quot;&quot; then [&quot;Category is required.&quot;] else [], if origin = null or origin = &quot;&quot; then [&quot;Farm origin is required.&quot;] else [], if allergens = null or allergens = &quot;&quot; then [&quot;Allergen information is required.&quot;] else [], if harvestDate = null or harvestDate = &quot;&quot; then [&quot;Harvest date is required.&quot;] else [], if bestBeforeDate = null or bestBeforeDate = &quot;&quot; then [&quot;Best-before date is required.&quot;] else [], if availableFrom = null or availableFrom = &quot;&quot; then [&quot;Availability start date is required.&quot;] else [], if availableUntil = null or availableUntil = &quot;&quot; then [&quot;Availability end date is required.&quot;] else [], if price = null then [&quot;Price is required.&quot;] else [], if quantity = null then [&quot;Quantity is required.&quot;] else [])" resultVariable="validationErrors"/></bpmn:extensionElements><bpmn:incoming>Flow_1ng29mg</bpmn:incoming>
        <bpmn:outgoing>Flow_0h1pspb</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0h1pspb" sourceRef="Task_ValidateMandatory" targetRef="Task_ValidatePriceStock"/>
      <bpmn:sequenceFlow id="Flow_0ikorw2" sourceRef="Task_ValidatePriceStock" targetRef="Task_ValidateSeason"/>
      <bpmn:sequenceFlow id="Flow_09l5u5q" sourceRef="Task_ValidateSeason" targetRef="Task_ValidateOrigin"/>
      <bpmn:sequenceFlow id="Flow_15lizhh" sourceRef="Task_ValidateOrigin" targetRef="Task_ValidateAllergenDates"/>
      <bpmn:scriptTask id="Task_ValidatePriceStock" name="Validate price and stock quantity">
        <bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if price != null and price &lt;= 0 then [&quot;Price must be greater than zero.&quot;] else [], if quantity != null and quantity &lt; 0 then [&quot;Quantity cannot be negative.&quot;] else [], if quantity != null and floor(quantity) != quantity then [&quot;Quantity must be a whole number.&quot;] else [])" resultVariable="validationErrors"/></bpmn:extensionElements><bpmn:incoming>Flow_0h1pspb</bpmn:incoming>
        <bpmn:outgoing>Flow_0ikorw2</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidateSeason" name="Validate seasonal availability dates">
        <bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if availableFrom != null and availableFrom != &quot;&quot; and availableUntil != null and availableUntil != &quot;&quot; and date(availableUntil) &lt; date(availableFrom) then [&quot;Availability end date must be on or after the start date.&quot;] else [])" resultVariable="validationErrors"/></bpmn:extensionElements><bpmn:incoming>Flow_0ikorw2</bpmn:incoming>
        <bpmn:outgoing>Flow_09l5u5q</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidateOrigin" name="Validate origin and harvest information">
        <bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if harvestDate != null and harvestDate != &quot;&quot; and date(harvestDate) &gt; today() then [&quot;Harvest date cannot be in the future.&quot;] else [])" resultVariable="validationErrors"/></bpmn:extensionElements><bpmn:incoming>Flow_09l5u5q</bpmn:incoming>
        <bpmn:outgoing>Flow_15lizhh</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Task_ValidateAllergenDates" name="Validate allergen and date information">
        <bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if bestBeforeDate != null and bestBeforeDate != &quot;&quot; and harvestDate != null and harvestDate != &quot;&quot; and date(bestBeforeDate) &lt;= date(harvestDate) then [&quot;Best-before date must be after the harvest date.&quot;] else [], if bestBeforeDate != null and bestBeforeDate != &quot;&quot; and date(bestBeforeDate) &lt; today() then [&quot;Best-before date has already passed.&quot;] else [])" resultVariable="validationErrors"/></bpmn:extensionElements><bpmn:incoming>Flow_15lizhh</bpmn:incoming>
        <bpmn:outgoing>Flow_0npzocb</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0npzocb" sourceRef="Task_ValidateAllergenDates" targetRef="Task_CheckCertificationDetails"/>
      <bpmn:scriptTask id="Task_CheckCertificationDetails" name="Check organic certification details">
        <bpmn:extensionElements><zeebe:script expression="=concatenate(validationErrors, if organicClaimMade = true and (certificationReference = null or certificationReference = &quot;&quot;) then [&quot;A certification reference is required for an organic claim.&quot;] else if organicClaimMade = true and not(matches(certificationReference, &quot;^GB-ORG-[0-9]{2}$&quot;)) then [&quot;Certification reference must be a UK organic control body code, e.g. GB-ORG-05.&quot;] else [])" resultVariable="validationErrors"/></bpmn:extensionElements><bpmn:incoming>Flow_0npzocb</bpmn:incoming>
        <bpmn:outgoing>Flow_0eacfzp</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="End_Validation" name="Validation completed.">
        <bpmn:incoming>Flow_0eacfzp</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0eacfzp" sourceRef="Task_CheckCertificationDetails" targetRef="End_Validation"/>
    </bpmn:subProcess>
    <bpmn:dataObjectReference id="DataObjectReference_1aptw5a" name="Submitted product details" dataObjectRef="DataObject_09tz9ti"/>
    <bpmn:dataObject id="DataObject_09tz9ti"/>
    <bpmn:scriptTask id="Task_WithholdManual" name="Withhold listing">
      <bpmn:extensionElements><zeebe:script expression="=&quot;Withheld&quot;" resultVariable="listingStatus"/></bpmn:extensionElements><bpmn:incoming>Flow_1m3z35p</bpmn:incoming>
      <bpmn:outgoing>Flow_141v5ka</bpmn:outgoing>
    </bpmn:scriptTask>
