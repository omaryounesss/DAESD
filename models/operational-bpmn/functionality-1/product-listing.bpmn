        <bpmn:incoming>Flow_1cx4l11</bpmn:incoming>
        <bpmn:outgoing>Flow_0iwpp9a</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_1yonvrt" name="Check producer and certification details">
        <bpmn:extensionElements>
