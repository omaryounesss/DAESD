    <bpmn:subProcess id="Activity_0eduspn" name="Manually review certification">
      <bpmn:documentation>The Marketplace Administrator reviews submitted certification evidence, checks producer and certification details, and records a justified approval or rejection decision. The review produces the Boolean variable manualCertificationVerified, which determines whether the listing may proceed with its organic claim or must be withheld.</bpmn:documentation>
      <bpmn:incoming>Flow_1f3fp0q</bpmn:incoming>
      <bpmn:outgoing>Flow_0jq0h51</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0p9abmx">
        <bpmn:targetRef>DataObjectReference_0h7zqgw</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Event_1ctpu4i" name="Manual review initiated">
