      <bpmn:sequenceFlow id="Flow_0bawn2x" sourceRef="Activity_1yonvrt" targetRef="Activity_0azxsu0" />
      <bpmn:endEvent id="Event_19ckojb" name="Manual review completed">
        <bpmn:incoming>Flow_0ka957w</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0ka957w" sourceRef="Activity_0azxsu0" targetRef="Event_19ckojb" />
      <bpmn:userTask id="Activity_0azxsu0" name="Record manual review decision">
