    <bpmn:serviceTask id="Activity_1k1i4wn" name="Record certification timeout">
      <bpmn:documentation>When certification verification times out, the process checks whether another attempt is permitted. The variable certificationAttempts counts requests sent, including the initial request. It is initialised to zero before the first request and incremented once each time a certification request is sent. A maximum of three requests is permitted. After the third timeout, the listing is escalated for manual review.</bpmn:documentation>
      <bpmn:incoming>Flow_0hezqyk</bpmn:incoming>
      <bpmn:outgoing>Flow_1h6asef</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_1229376" name="Certification response timeout">
      <bpmn:incoming>Flow_13fop81</bpmn:incoming>
      <bpmn:outgoing>Flow_0hezqyk</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1oeh2ig">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gateway_0yzch99">
